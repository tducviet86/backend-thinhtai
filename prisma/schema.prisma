generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum LocationType {
  COUNTRY
  CITY
  DISTRICT
  AREA
  LANDMARK
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PropertyStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum UnitStatus {
  DRAFT
  PUBLISHED
  TEMP_UNAVAILABLE
  INACTIVE
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
  FLOOR_PLAN
}

enum AvailabilityState {
  AVAILABLE
  HOLD
  BOOKED
  BLOCKED
  MAINTENANCE
}

enum HoldStatus {
  ACTIVE
  EXPIRED
  CONVERTED
  CANCELLED
}

enum BookingSource {
  WEBSITE
  FACEBOOK
  ZALO
  WHATSAPP
  PHONE
  WALK_IN
  AIRBNB
  BOOKING_COM
  OTHER
}

enum BookingStatus {
  DRAFT
  PENDING_PAYMENT
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  COMPLETED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_STAFF
  CANCELLED_BY_ADMIN
  PAYMENT_FAILED
  NO_SHOW
}

enum PaymentType {
  DEPOSIT
  BALANCE
  FULL
  REFUND
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SeoPageType {
  HOME
  LOCATION
  PROPERTY
  UNIT
  LANDING
  BLOG
  STATIC
}

enum SeoPageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  passwordHash  String
  firstName     String
  lastName      String
  status        UserStatus     @default(ACTIVE)
  tokenVersion  Int            @default(0)
  roles         UserRole[]
  refreshTokens RefreshToken[]
  customer      Customer?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  name        String
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  description String?
  roles       RolePermission[]
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())

  @@index([userId, expiresAt])
}

model Customer {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String?   @unique @db.Uuid
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  email       String?
  phone       String
  nationality String?
  notes       String?
  bookings    Booking[]
  reviews     Review[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([phone])
  @@index([email])
}

model Location {
  id           String        @id @default(uuid()) @db.Uuid
  parentId     String?       @db.Uuid
  parent       Location?     @relation("LocationTree", fields: [parentId], references: [id])
  children     Location[]    @relation("LocationTree")
  type         LocationType
  nameVi       String
  nameEn       String
  slugVi       String
  slugEn       String
  latitude     Decimal?      @db.Decimal(9, 6)
  longitude    Decimal?      @db.Decimal(9, 6)
  status       ContentStatus @default(DRAFT)
  properties   Property[]
  landingPages LandingPage[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([parentId, slugVi])
  @@unique([parentId, slugEn])
  @@index([type, status])
}

model Property {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  slugVi        String         @unique
  slugEn        String         @unique
  descriptionVi String
  descriptionEn String
  locationId    String         @db.Uuid
  location      Location       @relation(fields: [locationId], references: [id])
  address       String
  latitude      Decimal        @db.Decimal(9, 6)
  longitude     Decimal        @db.Decimal(9, 6)
  checkInTime   String
  checkOutTime  String
  status        PropertyStatus @default(DRAFT)
  units         Unit[]
  landingPages  LandingPage[]
  publishedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([locationId, status])
}

model Unit {
  id                 String              @id @default(uuid()) @db.Uuid
  propertyId         String              @db.Uuid
  property           Property            @relation(fields: [propertyId], references: [id])
  internalCode       String              @unique
  publicCode         String              @unique
  nameVi             String
  nameEn             String
  slugVi             String              @unique
  slugEn             String              @unique
  descriptionVi      String
  descriptionEn      String
  bedroomCount       Int
  bathroomCount      Decimal             @db.Decimal(3, 1)
  bedCount           Int
  maxGuests          Int
  area               Decimal             @db.Decimal(8, 2)
  viewType           String?
  basePrice          Decimal             @db.Decimal(12, 2)
  currency           String              @db.Char(3)
  cleaningFee        Decimal             @default(0) @db.Decimal(12, 2)
  serviceFeeRate     Decimal             @default(0) @db.Decimal(5, 4)
  depositRate        Decimal             @default(0) @db.Decimal(5, 4)
  status             UnitStatus          @default(DRAFT)
  amenities          UnitAmenity[]
  media              UnitMedia[]
  dailyRates         DailyRate[]
  ratePlans          RatePlan[]
  holds              Hold[]
  bookings           Booking[]
  reviews            Review[]
  availabilityBlocks AvailabilityBlock[]
  publishedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([propertyId, status])
  @@index([status, bedroomCount, maxGuests])
}

model Amenity {
  id       String        @id @default(uuid()) @db.Uuid
  code     String        @unique
  nameVi   String
  nameEn   String
  icon     String?
  category String
  units    UnitAmenity[]
}

model UnitAmenity {
  unitId    String  @db.Uuid
  amenityId String  @db.Uuid
  unit      Unit    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([unitId, amenityId])
}

model Media {
  id         String      @id @default(uuid()) @db.Uuid
  storageKey String      @unique
  url        String
  width      Int?
  height     Int?
  mimeType   String
  fileSize   Int
  altVi      String?
  altEn      String?
  captionVi  String?
  captionEn  String?
  units      UnitMedia[]
  createdAt  DateTime    @default(now())
}

model UnitMedia {
  unitId    String    @db.Uuid
  mediaId   String    @db.Uuid
  sortOrder Int
  type      MediaType
  unit      Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  media     Media     @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([unitId, mediaId])
  @@unique([unitId, sortOrder])
}

model RatePlan {
  id                String  @id @default(uuid()) @db.Uuid
  unitId            String  @db.Uuid
  unit              Unit    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  name              String
  weekendMultiplier Decimal @default(1) @db.Decimal(5, 2)
  active            Boolean @default(true)

  @@index([unitId, active])
}

model DailyRate {
  id      String   @id @default(uuid()) @db.Uuid
  unitId  String   @db.Uuid
  unit    Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  date    DateTime @db.Date
  amount  Decimal  @db.Decimal(12, 2)
  minStay Int?

  @@unique([unitId, date])
}

model Promotion {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique
  percentOff Decimal? @db.Decimal(5, 2)
  amountOff  Decimal? @db.Decimal(12, 2)
  startsAt   DateTime
  endsAt     DateTime
  active     Boolean  @default(true)
  maxUses    Int?
  uses       Int      @default(0)
}

model PriceQuote {
  id              String   @id @default(uuid()) @db.Uuid
  unitId          String   @db.Uuid
  checkIn         DateTime @db.Date
  checkOut        DateTime @db.Date
  guests          Int
  currency        String   @db.Char(3)
  breakdown       Json
  subtotal        Decimal  @db.Decimal(12, 2)
  cleaningFee     Decimal  @db.Decimal(12, 2)
  serviceFee      Decimal  @db.Decimal(12, 2)
  discount        Decimal  @db.Decimal(12, 2)
  total           Decimal  @db.Decimal(12, 2)
  requiredDeposit Decimal  @db.Decimal(12, 2)
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@index([unitId, expiresAt])
}

model Hold {
  id             String     @id @default(uuid()) @db.Uuid
  unitId         String     @db.Uuid
  unit           Unit       @relation(fields: [unitId], references: [id])
  bookingDraftId String?    @unique @db.Uuid
  startDate      DateTime   @db.Date
  endDate        DateTime   @db.Date
  expiresAt      DateTime
  status         HoldStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())

  @@index([unitId, status, startDate, endDate])
  @@index([status, expiresAt])
}

model AvailabilityBlock {
  id              String            @id @default(uuid()) @db.Uuid
  unitId          String            @db.Uuid
  unit            Unit              @relation(fields: [unitId], references: [id])
  startDate       DateTime          @db.Date
  endDate         DateTime          @db.Date
  state           AvailabilityState
  reason          String?
  createdByUserId String?           @db.Uuid
  createdAt       DateTime          @default(now())

  @@index([unitId, state, startDate, endDate])
}

model Booking {
  id              String              @id @default(uuid()) @db.Uuid
  bookingCode     String              @unique
  customerId      String              @db.Uuid
  customer        Customer            @relation(fields: [customerId], references: [id])
  unitId          String              @db.Uuid
  unit            Unit                @relation(fields: [unitId], references: [id])
  source          BookingSource
  checkIn         DateTime            @db.Date
  checkOut        DateTime            @db.Date
  guestCount      Int
  status          BookingStatus
  currency        String              @db.Char(3)
  subtotal        Decimal             @db.Decimal(12, 2)
  fees            Decimal             @db.Decimal(12, 2)
  discount        Decimal             @db.Decimal(12, 2)
  total           Decimal             @db.Decimal(12, 2)
  depositRequired Decimal             @db.Decimal(12, 2)
  paidAmount      Decimal             @default(0) @db.Decimal(12, 2)
  remainingAmount Decimal             @db.Decimal(12, 2)
  normalTotal     Decimal?            @db.Decimal(12, 2)
  overrideReason  String?
  createdByUserId String?             @db.Uuid
  payments        Payment[]
  reviews         Review[]
  unitChanges     BookingUnitChange[]
  extensions      BookingExtension[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([unitId, status, checkIn, checkOut])
  @@index([customerId, createdAt])
}

model BookingUnitChange {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @db.Uuid
  booking   Booking  @relation(fields: [bookingId], references: [id])
  oldUnitId String   @db.Uuid
  newUnitId String   @db.Uuid
  reason    String
  changedBy String   @db.Uuid
  changedAt DateTime @default(now())

  @@index([bookingId, changedAt])
}

model BookingExtension {
  id               String   @id @default(uuid()) @db.Uuid
  bookingId        String   @db.Uuid
  booking          Booking  @relation(fields: [bookingId], references: [id])
  oldCheckOut      DateTime @db.Date
  newCheckOut      DateTime @db.Date
  additionalCharge Decimal  @db.Decimal(12, 2)
  reason           String?
  changedBy        String   @db.Uuid
  changedAt        DateTime @default(now())

  @@index([bookingId, changedAt])
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  bookingId         String        @db.Uuid
  booking           Booking       @relation(fields: [bookingId], references: [id])
  type              PaymentType
  method            String
  provider          String?
  providerReference String?
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @db.Char(3)
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  paidAt            DateTime?

  @@unique([provider, providerReference])
  @@index([bookingId, status])
}

model PaymentWebhookEvent {
  id              String    @id @default(uuid()) @db.Uuid
  provider        String
  providerEventId String
  payloadHash     String
  processedAt     DateTime?
  error           String?
  createdAt       DateTime  @default(now())

  @@unique([provider, providerEventId])
}

model Review {
  id         String       @id @default(uuid()) @db.Uuid
  bookingId  String       @db.Uuid
  booking    Booking      @relation(fields: [bookingId], references: [id])
  unitId     String       @db.Uuid
  unit       Unit         @relation(fields: [unitId], references: [id])
  customerId String       @db.Uuid
  customer   Customer     @relation(fields: [customerId], references: [id])
  rating     Int
  comment    String
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  @@unique([bookingId])
  @@index([unitId, status])
}

model LandingPage {
  id            String        @id @default(uuid()) @db.Uuid
  type          String
  locale        String        @db.VarChar(5)
  name          String
  slug          String
  locationId    String?       @db.Uuid
  location      Location?     @relation(fields: [locationId], references: [id])
  propertyId    String?       @db.Uuid
  property      Property?     @relation(fields: [propertyId], references: [id])
  bedroomCount  Int?
  viewType      String?
  heading       String
  contentTop    String
  contentBottom String
  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([locale, slug])
  @@index([status, locale])
}

model BlogCategory {
  id     String     @id @default(uuid()) @db.Uuid
  locale String     @db.VarChar(5)
  name   String
  slug   String
  posts  BlogPost[]

  @@unique([locale, slug])
}

model BlogPost {
  id              String        @id @default(uuid()) @db.Uuid
  locale          String        @db.VarChar(5)
  title           String
  slug            String
  excerpt         String
  content         String
  featuredImageId String?       @db.Uuid
  categoryId      String        @db.Uuid
  category        BlogCategory  @relation(fields: [categoryId], references: [id])
  authorId        String        @db.Uuid
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  updatedAt       DateTime      @updatedAt
  createdAt       DateTime      @default(now())

  @@unique([locale, slug])
  @@index([status, locale, publishedAt])
}

model SeoPage {
  id                 String           @id @default(uuid()) @db.Uuid
  pageType           SeoPageType
  referenceId        String           @db.Uuid
  locale             String           @db.VarChar(5)
  slug               String
  path               String
  title              String
  metaDescription    String
  h1                 String
  canonicalUrl       String
  robotsIndex        Boolean          @default(false)
  robotsFollow       Boolean          @default(true)
  ogTitle            String
  ogDescription      String
  ogImageId          String?          @db.Uuid
  twitterTitle       String?
  twitterDescription String?
  twitterImageId     String?          @db.Uuid
  schemaType         String?
  schemaOverrides    Json?
  sitemapIncluded    Boolean          @default(false)
  sitemapPriority    Decimal?         @db.Decimal(2, 1)
  status             SeoPageStatus    @default(DRAFT)
  publishedAt        DateTime?
  slugHistory        SeoSlugHistory[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([path])
  @@unique([pageType, referenceId, locale])
  @@index([status, robotsIndex, sitemapIncluded])
  @@index([pageType, referenceId])
}

model SeoRedirect {
  id              String   @id @default(uuid()) @db.Uuid
  sourcePath      String   @unique
  destinationPath String?
  statusCode      Int
  reason          String
  createdBy       String   @db.Uuid
  createdAt       DateTime @default(now())
}

model SeoSlugHistory {
  id        String   @id @default(uuid()) @db.Uuid
  seoPageId String   @db.Uuid
  seoPage   SeoPage  @relation(fields: [seoPageId], references: [id])
  oldPath   String
  newPath   String
  changedBy String   @db.Uuid
  changedAt DateTime @default(now())

  @@index([seoPageId, changedAt])
  @@index([oldPath])
}

model SeoAuditFinding {
  id         String    @id @default(uuid()) @db.Uuid
  seoPageId  String?   @db.Uuid
  code       String
  severity   String
  details    Json?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([seoPageId, resolvedAt])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
}
