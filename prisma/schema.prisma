generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum LocationType {
  COUNTRY
  CITY
  DISTRICT
  AREA
  LANDMARK
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PropertyStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum UnitStatus {
  DRAFT
  PUBLISHED
  TEMP_UNAVAILABLE
  INACTIVE
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
  FLOOR_PLAN
}

enum AvailabilityState {
  AVAILABLE
  HOLD
  BOOKED
  BLOCKED
  MAINTENANCE
}

enum HoldStatus {
  ACTIVE
  EXPIRED
  CONVERTED
  CANCELLED
}

enum BookingSource {
  WEBSITE
  FACEBOOK
  ZALO
  WHATSAPP
  PHONE
  WALK_IN
  AIRBNB
  BOOKING_COM
  OTHER
}

enum BookingStatus {
  DRAFT
  PENDING_PAYMENT
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  COMPLETED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_STAFF
  CANCELLED_BY_ADMIN
  PAYMENT_FAILED
  NO_SHOW
  EXPIRED
}

enum PaymentType {
  DEPOSIT
  BALANCE
  FULL
  REFUND
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  SUPERSEDED
  EXPIRED
}

enum PaymentOption {
  DEPOSIT_50
  FULL_100
}

enum PaymentPurpose {
  INITIAL
  BALANCE
  MANUAL
}

enum CaptureDisposition {
  APPLIED
  REFUND_REQUIRED
  REVIEW_REQUIRED
}

enum CancellationCause {
  CUSTOMER_CANCELLATION
  OPERATOR_CANCELLATION
  BOOKING_EXPIRY
}

enum CancellationActor {
  CUSTOMER
  STAFF
  ADMIN
  SYSTEM
}

enum RefundReason {
  CUSTOMER_CANCELLATION
  OPERATOR_CANCELLATION
  BOOKING_EXPIRY
  LATE_CAPTURE
  SUPERSEDED_CAPTURE
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  PENDING_PROVIDER
  SUCCEEDED
  RETRYABLE_FAILED
  MANUAL_REVIEW
}

enum RefundAttemptStatus {
  PREPARED
  SENT
  PENDING
  SUCCEEDED
  DEFINITIVELY_FAILED
  UNKNOWN
}

enum WebhookEventStatus {
  RECEIVED
  APPLIED
  REFUND_SCHEDULED
  FAILURE_RECORDED
  REVIEW_REQUIRED
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SeoPageType {
  HOME
  LOCATION
  PROPERTY
  UNIT
  LANDING
  BLOG
  STATIC
}

enum SeoPageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id            String                @id @default(uuid()) @db.Uuid
  email         String                @unique
  passwordHash  String
  firstName     String
  lastName      String
  status        UserStatus            @default(ACTIVE)
  tokenVersion  Int                   @default(0)
  roles         UserRole[]
  refreshTokens RefreshToken[]
  customer      Customer?
  cancellations BookingCancellation[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  name        String
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  description String?
  roles       RolePermission[]
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RefreshToken {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @db.Uuid
  tokenHash    String        @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?       @unique @db.Uuid
  successor    RefreshToken? @relation("RefreshTokenRotation", fields: [replacedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  predecessor  RefreshToken? @relation("RefreshTokenRotation")
  // NULL preserves legacy revocations; later rotation code sets this atomically.
  consumedAt   DateTime?      @db.Timestamptz(3)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())

  @@index([userId, expiresAt])
}

model Customer {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String?   @unique @db.Uuid
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  email       String?
  phone       String
  nationality String?
  notes       String?
  bookings    Booking[]
  reviews     Review[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([phone])
  @@index([email])
}

model Location {
  id           String        @id @default(uuid()) @db.Uuid
  parentId     String?       @db.Uuid
  parent       Location?     @relation("LocationTree", fields: [parentId], references: [id])
  children     Location[]    @relation("LocationTree")
  type         LocationType
  nameVi       String
  nameEn       String
  slugVi       String
  slugEn       String
  latitude     Decimal?      @db.Decimal(9, 6)
  longitude    Decimal?      @db.Decimal(9, 6)
  status       ContentStatus @default(DRAFT)
  properties   Property[]
  landingPages LandingPage[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([parentId, slugVi])
  @@unique([parentId, slugEn])
  @@index([type, status])
}

model Property {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  slugVi        String         @unique
  slugEn        String         @unique
  descriptionVi String
  descriptionEn String
  locationId    String         @db.Uuid
  location      Location       @relation(fields: [locationId], references: [id])
  address       String
  latitude      Decimal        @db.Decimal(9, 6)
  longitude     Decimal        @db.Decimal(9, 6)
  checkInTime   String
  checkOutTime  String
  status        PropertyStatus @default(DRAFT)
  units         Unit[]
  landingPages  LandingPage[]
  publishedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([locationId, status])
}

model Unit {
  id                 String              @id @default(uuid()) @db.Uuid
  propertyId         String              @db.Uuid
  property           Property            @relation(fields: [propertyId], references: [id])
  internalCode       String              @unique
  publicCode         String              @unique
  nameVi             String
  nameEn             String
  slugVi             String              @unique
  slugEn             String              @unique
  descriptionVi      String
  descriptionEn      String
  bedroomCount       Int
  bathroomCount      Decimal             @db.Decimal(3, 1)
  bedCount           Int
  maxGuests          Int
  area               Decimal             @db.Decimal(8, 2)
  viewType           String?
  basePrice          Decimal             @db.Decimal(12, 2)
  currency           String              @db.Char(3)
  cleaningFee        Decimal             @default(0) @db.Decimal(12, 2)
  serviceFeeRate     Decimal             @default(0) @db.Decimal(5, 4)
  depositRate        Decimal             @default(0) @db.Decimal(5, 4)
  status             UnitStatus          @default(DRAFT)
  amenities          UnitAmenity[]
  media              UnitMedia[]
  dailyRates         DailyRate[]
  ratePlans          RatePlan[]
  holds              Hold[]
  bookings           Booking[]
  reviews            Review[]
  availabilityBlocks AvailabilityBlock[]
  publishedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([propertyId, status])
  @@index([status, bedroomCount, maxGuests])
}

model Amenity {
  id       String        @id @default(uuid()) @db.Uuid
  code     String        @unique
  nameVi   String
  nameEn   String
  icon     String?
  category String
  units    UnitAmenity[]
}

model UnitAmenity {
  unitId    String  @db.Uuid
  amenityId String  @db.Uuid
  unit      Unit    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([unitId, amenityId])
}

model Media {
  id         String      @id @default(uuid()) @db.Uuid
  storageKey String      @unique
  url        String
  width      Int?
  height     Int?
  mimeType   String
  fileSize   Int
  altVi      String?
  altEn      String?
  captionVi  String?
  captionEn  String?
  units      UnitMedia[]
  createdAt  DateTime    @default(now())
}

model UnitMedia {
  unitId    String    @db.Uuid
  mediaId   String    @db.Uuid
  sortOrder Int
  type      MediaType
  unit      Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  media     Media     @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([unitId, mediaId])
  @@unique([unitId, sortOrder])
}

model RatePlan {
  id                String  @id @default(uuid()) @db.Uuid
  unitId            String  @db.Uuid
  unit              Unit    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  name              String
  weekendMultiplier Decimal @default(1) @db.Decimal(5, 2)
  active            Boolean @default(true)

  @@index([unitId, active])
}

model DailyRate {
  id      String   @id @default(uuid()) @db.Uuid
  unitId  String   @db.Uuid
  unit    Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  date    DateTime @db.Date
  amount  Decimal  @db.Decimal(12, 2)
  minStay Int?

  @@unique([unitId, date])
}

model Promotion {
  id         String       @id @default(uuid()) @db.Uuid
  code       String       @unique
  percentOff Decimal?     @db.Decimal(5, 2)
  amountOff  Decimal?     @db.Decimal(12, 2)
  startsAt   DateTime
  endsAt     DateTime
  active     Boolean      @default(true)
  maxUses    Int?
  uses       Int          @default(0)
  quotes     PriceQuote[]
}

model PriceQuote {
  id              String     @id @default(uuid()) @db.Uuid
  unitId          String     @db.Uuid
  checkIn         DateTime   @db.Date
  checkOut        DateTime   @db.Date
  guests          Int
  currency        String     @db.Char(3)
  breakdown       Json
  subtotal        Decimal    @db.Decimal(12, 2)
  cleaningFee     Decimal    @db.Decimal(12, 2)
  serviceFee      Decimal    @db.Decimal(12, 2)
  discount        Decimal    @db.Decimal(12, 2)
  total           Decimal    @db.Decimal(12, 2)
  requiredDeposit Decimal    @db.Decimal(12, 2)
  expiresAt       DateTime
  createdAt       DateTime   @default(now())
  holdId          String?    @db.Uuid
  hold            Hold?      @relation(fields: [holdId], references: [id], onDelete: Restrict)
  promotionId     String?    @db.Uuid
  promotion       Promotion? @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  booking         Booking?

  @@index([unitId, expiresAt])
  @@index([holdId])
}

model Hold {
  id             String       @id @default(uuid()) @db.Uuid
  unitId         String       @db.Uuid
  unit           Unit         @relation(fields: [unitId], references: [id])
  bookingDraftId String?      @unique @db.Uuid
  // Reuse the existing conversion identifier; its new FK is initially NOT VALID in SQL.
  booking        Booking?     @relation(fields: [bookingDraftId], references: [id], onDelete: Restrict)
  startDate      DateTime     @db.Date
  endDate        DateTime     @db.Date
  expiresAt      DateTime
  status         HoldStatus   @default(ACTIVE)
  createdAt      DateTime     @default(now())
  // NULL identifies legacy holds; no raw token or identifying fingerprint is stored.
  tokenHash      String?      @unique @db.VarChar(64)
  clientKeyHash  String?      @db.VarChar(64)
  convertedAt    DateTime?    @db.Timestamptz(3)
  releasedAt     DateTime?    @db.Timestamptz(3)
  expiredAt      DateTime?    @db.Timestamptz(3)
  quotes         PriceQuote[]

  @@index([unitId, status, startDate, endDate])
  @@index([status, expiresAt])
  @@index([clientKeyHash, status, expiresAt])
}

model AvailabilityBlock {
  id              String            @id @default(uuid()) @db.Uuid
  unitId          String            @db.Uuid
  unit            Unit              @relation(fields: [unitId], references: [id])
  startDate       DateTime          @db.Date
  endDate         DateTime          @db.Date
  state           AvailabilityState
  reason          String?
  createdByUserId String?           @db.Uuid
  createdAt       DateTime          @default(now())

  @@index([unitId, state, startDate, endDate])
}

model Booking {
  id                   String               @id @default(uuid()) @db.Uuid
  bookingCode          String               @unique
  customerId           String               @db.Uuid
  customer             Customer             @relation(fields: [customerId], references: [id])
  unitId               String               @db.Uuid
  unit                 Unit                 @relation(fields: [unitId], references: [id])
  source               BookingSource
  checkIn              DateTime             @db.Date
  checkOut             DateTime             @db.Date
  guestCount           Int
  status               BookingStatus
  currency             String               @db.Char(3)
  subtotal             Decimal              @db.Decimal(12, 2)
  fees                 Decimal              @db.Decimal(12, 2)
  discount             Decimal              @db.Decimal(12, 2)
  total                Decimal              @db.Decimal(12, 2)
  depositRequired      Decimal              @db.Decimal(12, 2)
  paidAmount           Decimal              @default(0) @db.Decimal(12, 2)
  remainingAmount      Decimal              @db.Decimal(12, 2)
  normalTotal          Decimal?             @db.Decimal(12, 2)
  overrideReason       String?
  createdByUserId      String?              @db.Uuid
  payments             Payment[]
  reviews              Review[]
  unitChanges          BookingUnitChange[]
  extensions           BookingExtension[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  // Nullable, without inferred defaults: historical commercial terms remain untouched.
  paymentOption        PaymentOption?
  confirmationRequired Decimal?             @db.Decimal(12, 2)
  paymentDueAt         DateTime?            @db.Timestamptz(3)
  expiredAt            DateTime?            @db.Timestamptz(3)
  confirmedAt          DateTime?            @db.Timestamptz(3)
  checkInAt            DateTime?            @db.Timestamptz(3)
  stayTimeZone         String?
  policyVersion        String?
  pricingSnapshot      Json?
  quoteId              String?              @unique @db.Uuid
  quote                PriceQuote?          @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  hold                 Hold?
  cancellation         BookingCancellation?
  captures             PaymentCapture[]
  refunds              Refund[]

  @@index([unitId, status, checkIn, checkOut])
  @@index([customerId, createdAt])
  @@index([status, paymentDueAt])
}

model BookingUnitChange {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @db.Uuid
  booking   Booking  @relation(fields: [bookingId], references: [id])
  oldUnitId String   @db.Uuid
  newUnitId String   @db.Uuid
  reason    String
  changedBy String   @db.Uuid
  changedAt DateTime @default(now())

  @@index([bookingId, changedAt])
}

model BookingExtension {
  id               String   @id @default(uuid()) @db.Uuid
  bookingId        String   @db.Uuid
  booking          Booking  @relation(fields: [bookingId], references: [id])
  oldCheckOut      DateTime @db.Date
  newCheckOut      DateTime @db.Date
  additionalCharge Decimal  @db.Decimal(12, 2)
  reason           String?
  changedBy        String   @db.Uuid
  changedAt        DateTime @default(now())

  @@index([bookingId, changedAt])
}

model Payment {
  id                 String                @id @default(uuid()) @db.Uuid
  bookingId          String                @db.Uuid
  booking            Booking               @relation(fields: [bookingId], references: [id])
  type               PaymentType
  method             String
  provider           String?
  providerReference  String?
  amount             Decimal               @db.Decimal(12, 2)
  currency           String                @db.Char(3)
  status             PaymentStatus         @default(PENDING)
  createdAt          DateTime              @default(now())
  paidAt             DateTime?
  // amount/providerReference/createdAt already represent the request, merchant reference and creation time.
  purpose            PaymentPurpose?
  merchantId         String?
  expiresAt          DateTime?             @db.Timestamptz(3)
  supersededAt       DateTime?             @db.Timestamptz(3)
  closedAt           DateTime?             @db.Timestamptz(3)
  providerCreateDate String?               @db.VarChar(14)
  providerRequest    Json?
  nextReconcileAt    DateTime?             @db.Timestamptz(3)
  leaseUntil         DateTime?             @db.Timestamptz(3)
  leaseOwner         String?
  captures           PaymentCapture[]
  webhookEvents      PaymentWebhookEvent[]
  // SQL also enforces one live VNPAY attempt per booking for purpose IS NOT NULL.

  @@unique([provider, providerReference])
  // Composite FK target prevents captures from being attached to a different booking.
  @@unique([id, bookingId])
  @@index([bookingId, status])
  @@index([status, nextReconcileAt])
}

model PaymentWebhookEvent {
  id               String              @id @default(uuid()) @db.Uuid
  provider         String
  providerEventId  String
  payloadHash      String
  processedAt      DateTime?
  error            String?
  createdAt        DateTime            @default(now())
  paymentId        String?             @db.Uuid
  payment          Payment?            @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  merchantId       String?
  eventFingerprint String?             @db.VarChar(64)
  status           WebhookEventStatus?
  ackCode          String?             @db.VarChar(2)
  providerEvidence Json?

  @@unique([provider, providerEventId])
  @@unique([provider, merchantId, eventFingerprint], map: "PaymentWebhookEvent_scoped_fingerprint_key")
  @@index([paymentId])
  @@index([status, createdAt])
}

// A charge can exist even when its attempt was superseded or its booking is terminal.
model PaymentCapture {
  id                    String             @id @default(uuid()) @db.Uuid
  paymentId             String             @db.Uuid
  bookingId             String             @db.Uuid
  payment               Payment            @relation(fields: [paymentId, bookingId], references: [id, bookingId], onDelete: Restrict)
  booking               Booking            @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  provider              String
  merchantId            String
  providerTransactionId String
  amount                Decimal            @db.Decimal(12, 2)
  currency              String             @db.Char(3)
  appliedAmount         Decimal            @default(0) @db.Decimal(12, 2)
  disposition           CaptureDisposition
  capturedAt            DateTime?          @db.Timestamptz(3)
  recordedAt            DateTime           @default(now()) @db.Timestamptz(3)
  providerEvidence      Json?
  refunds               Refund[]

  @@unique([provider, merchantId, providerTransactionId], map: "PaymentCapture_provider_transaction_key")
  @@unique([id, bookingId])
  @@index([paymentId, bookingId])
  @@index([bookingId, recordedAt])
}

model BookingCancellation {
  id                String            @id @default(uuid()) @db.Uuid
  bookingId         String            @unique @db.Uuid
  booking           Booking           @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  cause             CancellationCause
  actorType         CancellationActor
  actorUserId       String?           @db.Uuid
  actor             User?             @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  reason            String
  cancelledAt       DateTime          @db.Timestamptz(3)
  checkInAt         DateTime          @db.Timestamptz(3)
  policyVersion     String
  paidBasis         Decimal           @db.Decimal(12, 2)
  refundPercent     Int
  refundEntitlement Decimal           @db.Decimal(12, 2)
  currency          String            @db.Char(3)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  refunds           Refund[]

  @@unique([id, bookingId])
  @@index([actorUserId, cancelledAt])
}

model Refund {
  id             String               @id @default(uuid()) @db.Uuid
  bookingId      String               @db.Uuid
  booking        Booking              @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  captureId      String               @db.Uuid
  capture        PaymentCapture       @relation(fields: [captureId, bookingId], references: [id, bookingId], onDelete: Restrict)
  cancellationId String?              @db.Uuid
  cancellation   BookingCancellation? @relation(fields: [cancellationId, bookingId], references: [id, bookingId], onDelete: Restrict)
  amount         Decimal              @db.Decimal(12, 2)
  currency       String               @db.Char(3)
  reason         RefundReason
  status         RefundStatus         @default(REQUESTED)
  idempotencyKey String               @unique @db.VarChar(128)
  requestedAt    DateTime             @default(now()) @db.Timestamptz(3)
  processedAt    DateTime?            @db.Timestamptz(3)
  nextAttemptAt  DateTime?            @db.Timestamptz(3)
  leaseUntil     DateTime?            @db.Timestamptz(3)
  leaseOwner     String?
  lastErrorCode  String?
  lastError      String?
  attempts       RefundAttempt[]

  @@unique([captureId, reason])
  @@index([bookingId, requestedAt])
  @@index([cancellationId, bookingId])
  @@index([status, nextAttemptAt])
}

// Provider request identity belongs to an execution, not a second refund obligation.
model RefundAttempt {
  id                      String              @id @default(uuid()) @db.Uuid
  refundId                String              @db.Uuid
  refund                  Refund              @relation(fields: [refundId], references: [id], onDelete: Restrict)
  sequence                Int
  provider                String
  merchantId              String
  providerRequestId       String              @db.VarChar(32)
  providerRefundReference String?
  status                  RefundAttemptStatus @default(PREPARED)
  requestPayload          Json
  responsePayload         Json?
  createdAt               DateTime            @default(now()) @db.Timestamptz(3)
  sentAt                  DateTime?           @db.Timestamptz(3)
  processedAt             DateTime?           @db.Timestamptz(3)
  errorCode               String?

  @@unique([refundId, sequence])
  @@unique([provider, merchantId, providerRequestId], map: "RefundAttempt_provider_request_key")
  @@unique([provider, merchantId, providerRefundReference], map: "RefundAttempt_provider_refund_key")
  @@index([status, createdAt])
}

model IdempotencyRecord {
  id                 String            @id @default(uuid()) @db.Uuid
  scope              String            @db.VarChar(160)
  keyHash            String            @db.VarChar(64)
  requestHash        String            @db.VarChar(64)
  status             IdempotencyStatus @default(IN_PROGRESS)
  resourceType       String?
  resourceId         String?           @db.Uuid
  httpStatus         Int?
  // Only encrypted response bytes, if recovering a lost secret-bearing response is necessary.
  responseCiphertext Bytes?
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  expiresAt          DateTime?         @db.Timestamptz(3)

  @@unique([scope, keyHash])
  @@index([expiresAt])
}

model Review {
  id         String       @id @default(uuid()) @db.Uuid
  bookingId  String       @db.Uuid
  booking    Booking      @relation(fields: [bookingId], references: [id])
  unitId     String       @db.Uuid
  unit       Unit         @relation(fields: [unitId], references: [id])
  customerId String       @db.Uuid
  customer   Customer     @relation(fields: [customerId], references: [id])
  rating     Int
  comment    String
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  @@unique([bookingId])
  @@index([unitId, status])
}

model LandingPage {
  id            String        @id @default(uuid()) @db.Uuid
  type          String
  locale        String        @db.VarChar(5)
  name          String
  slug          String
  locationId    String?       @db.Uuid
  location      Location?     @relation(fields: [locationId], references: [id])
  propertyId    String?       @db.Uuid
  property      Property?     @relation(fields: [propertyId], references: [id])
  bedroomCount  Int?
  viewType      String?
  heading       String
  contentTop    String
  contentBottom String
  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([locale, slug])
  @@index([status, locale])
}

model BlogCategory {
  id     String     @id @default(uuid()) @db.Uuid
  locale String     @db.VarChar(5)
  name   String
  slug   String
  posts  BlogPost[]

  @@unique([locale, slug])
}

model BlogPost {
  id              String        @id @default(uuid()) @db.Uuid
  locale          String        @db.VarChar(5)
  title           String
  slug            String
  excerpt         String
  content         String
  featuredImageId String?       @db.Uuid
  categoryId      String        @db.Uuid
  category        BlogCategory  @relation(fields: [categoryId], references: [id])
  authorId        String        @db.Uuid
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  updatedAt       DateTime      @updatedAt
  createdAt       DateTime      @default(now())

  @@unique([locale, slug])
  @@index([status, locale, publishedAt])
}

model SeoPage {
  id                 String           @id @default(uuid()) @db.Uuid
  pageType           SeoPageType
  referenceId        String           @db.Uuid
  locale             String           @db.VarChar(5)
  slug               String
  path               String
  title              String
  metaDescription    String
  h1                 String
  canonicalUrl       String
  robotsIndex        Boolean          @default(false)
  robotsFollow       Boolean          @default(true)
  ogTitle            String
  ogDescription      String
  ogImageId          String?          @db.Uuid
  twitterTitle       String?
  twitterDescription String?
  twitterImageId     String?          @db.Uuid
  schemaType         String?
  schemaOverrides    Json?
  sitemapIncluded    Boolean          @default(false)
  sitemapPriority    Decimal?         @db.Decimal(2, 1)
  status             SeoPageStatus    @default(DRAFT)
  publishedAt        DateTime?
  slugHistory        SeoSlugHistory[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([path])
  @@unique([pageType, referenceId, locale])
  @@index([status, robotsIndex, sitemapIncluded])
  @@index([pageType, referenceId])
}

model SeoRedirect {
  id              String   @id @default(uuid()) @db.Uuid
  sourcePath      String   @unique
  destinationPath String?
  statusCode      Int
  reason          String
  createdBy       String   @db.Uuid
  createdAt       DateTime @default(now())
}

model SeoSlugHistory {
  id        String   @id @default(uuid()) @db.Uuid
  seoPageId String   @db.Uuid
  seoPage   SeoPage  @relation(fields: [seoPageId], references: [id])
  oldPath   String
  newPath   String
  changedBy String   @db.Uuid
  changedAt DateTime @default(now())

  @@index([seoPageId, changedAt])
  @@index([oldPath])
}

model SeoAuditFinding {
  id         String    @id @default(uuid()) @db.Uuid
  seoPageId  String?   @db.Uuid
  code       String
  severity   String
  details    Json?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([seoPageId, resolvedAt])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
}
